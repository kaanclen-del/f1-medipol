[
  {
    "old": "const [showGraphics,setShowGraphics]=useState(false);",
    "new": "const [showGraphics,setShowGraphics]=useState(false);\n const [mobileMenuOpen,setMobileMenuOpen]=useState(false);"
  },
  {
    "old": "const lastRank=useRef(1);",
    "new": "const lastRank=useRef(1);\n const lastMobileUiUpdate=useRef(0);"
  },
  {
    "old": "onHud:next=>{setHud(next);sound.current?.update(next.speed,Boolean(next.throttle),pausedRef.current);",
    "new": "onHud:next=>{\n      const tick=performance.now();\n      const onPhone=typeof window!=='undefined'&&window.matchMedia('(pointer:coarse)').matches;\n      if(!onPhone||tick-lastMobileUiUpdate.current>115){lastMobileUiUpdate.current=tick;setHud(next);}\n      sound.current?.update(next.speed,Boolean(next.throttle),pausedRef.current);"
  },
  {
    "old": "return <section className={s.raceScreen} ref={raceRoot}>",
    "new": "return <section className={s.raceScreen} ref={raceRoot}\n  onPointerDownCapture={()=>{sound.current?.activate();ambience.current?.activate();}}>"
  },
  {
    "old": "<div className={s.raceActions}>\n   <button type=\"button\" onClick={()=>setShowGraphics(v=>!v)}",
    "new": "<div className={s.raceActions}>\n   <button type=\"button\" className={s.mobilePauseBtn} onClick={()=>{\n     const opening=!mobileMenuOpen;\n     if(opening){down('left',false);down('right',false);down('throttle',false);down('brake',false);}\n     if(!roomId&&opening!==pausedRef.current)togglePause();\n     setShowGraphics(false);setMobileMenuOpen(opening);\n   }}>{mobileMenuOpen?'✕ KAPAT':roomId?'Ⅱ MENÜ':'Ⅱ DURAKLAT'}</button>\n   <button type=\"button\" onClick={()=>setShowGraphics(v=>!v)}"
  },
  {
    "old": "</div>}\n  {paused&&!roomId&&ended===null&&<div className={s.pauseOverlay}>",
    "new": "</div>}\n  {mobileMenuOpen&&ended===null&&<div className={s.mobileMenuOverlay} role=\"dialog\" aria-modal=\"true\" aria-label=\"Yarış ve görüntü ayarları\">\n   <div className={s.mobileMenuCard}>\n    <div className={s.mobileMenuHeader}><span>F1 MEDIPOL · KART RUSH</span><h2>{roomId?'YARIŞ MENÜSÜ':'YARIŞ DURAKLATILDI'}</h2><p>{roomId?'Çevrimiçi yarış menü açıkken devam eder.':'Yarışın durduruldu. Devam ederek pistte kaldığın yerden sürebilirsin.'}</p></div>\n    <div className={s.mobileMenuSection}><strong>GRAFİK KALİTESİ</strong>\n     <div className={s.mobileGraphicsGrid}>{([{id:'low',label:'EKO'},{id:'balanced',label:'DENGELİ'},{id:'high',label:'YÜKSEK'},{id:'ultra',label:'ULTRA'}] as const).map(q=><button type=\"button\" key={q.id} className={graphics===q.id?s.mobileSelected:''} onClick={()=>onGraphicsChange?.(q.id)}>{q.label}</button>)}</div>\n     <small>iPhone'da grafik yükü, seçilen seviyeden bağımsız olarak ısınmaya karşı otomatik dengelenir.</small>\n    </div>\n    <div className={s.mobileMenuSection}><strong>SES</strong>\n     <button type=\"button\" className={s.mobileAudioButton} onClick={()=>{\n      sound.current?.activate();ambience.current?.activate();\n      if(volume<=.01)onVolumeChange?.(.62);\n      sound.current?.effect('horn');\n     }}>♫ SESİ ETKİNLEŞTİR / TEST ET</button>\n     <label className={s.mobileVolume}>SES DÜZEYİ · {Math.round(volume*100)}%\n      <input type=\"range\" min=\"0\" max=\"100\" value={Math.round(volume*100)} onChange={e=>{\n       const v=Number(e.target.value)/100;onVolumeChange?.(v);\n       sound.current?.activate();ambience.current?.activate();\n      }}/>\n     </label>\n    </div>\n    <div className={s.mobileMenuSection}><strong>YARIŞ SEÇENEKLERİ</strong>\n     <div className={s.mobileMenuChoices}>\n      <button type=\"button\" onClick={()=>{cycleCamera();}}>▣ KAMERA DEĞİŞTİR</button>\n      <button type=\"button\" onClick={()=>{setShowLeaderboard(v=>!v);setMobileMenuOpen(false);if(!roomId&&pausedRef.current)togglePause();}}>☰ SIRALAMA</button>\n      <button type=\"button\" onClick={()=>{void toggleFullscreen();}}>⛶ TAM EKRAN</button>\n      <button type=\"button\" onClick={onExit}>← ANA MENÜ</button>\n     </div>\n    </div>\n    <button type=\"button\" className={s.mobileResumeBtn} onClick={()=>{\n      if(!roomId&&pausedRef.current)togglePause();\n      setMobileMenuOpen(false);\n     }}>▶ YARIŞA DEVAM ET</button>\n   </div>\n  </div>}\n  {paused&&!mobileMenuOpen&&!roomId&&ended===null&&<div className={s.pauseOverlay}>"
  }
]